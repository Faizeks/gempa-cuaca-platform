# Salin file ini menjadi .env lalu sesuaikan isinya.
#   PowerShell : Copy-Item .env.example .env
# File .env berisi rahasia dan TIDAK boleh di-commit (sudah ada di .gitignore).

# --- Airflow ---
# Di Windows/Mac biarkan 50000. Di Linux isi dengan hasil perintah: id -u
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
# String acak panjang untuk menandatangani token internal Airflow
AIRFLOW_JWT_SECRET=ganti_dengan_string_acak_yang_panjang
# Opsional: kunci enkripsi koneksi Airflow. Buat dengan:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- PostgreSQL ---
AIRFLOW_DB_PASSWORD=airflow
WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=warehouse

# --- Spark ---
# Default memakai cluster (spark-master + spark-worker). Jika laptop berat, isi
# local[2] agar Spark berjalan di dalam container Airflow saja:
# SPARK_MASTER_URL=local[2]

# --- Ekstraksi ---
# Untuk uji cepat, batasi jumlah lokasi cuaca. 0 = semua 514 lokasi.
BMKG_CUACA_MAX_LOCATIONS=20

# --- Metabase (profile bi) ---
# Akun admin yang dibuat otomatis oleh service metabase-setup. Email tidak perlu asli.
MB_ADMIN_EMAIL=admin@example.com
MB_ADMIN_PASSWORD=Bencana2026!
# METABASE_VERSION=latest
